
      <html xmlns:o="urn:schemas-microsoft-com:office:office" xmlns:w="urn:schemas-microsoft-com:office:word" xmlns="http://www.w3.org/TR/REC-html40">
        <head>
          <meta charset="utf-8">
          <title>Contract</title>
          <style>
            body { font-family: Arial, sans-serif; }
            h2 { color: #333; }
            p { line-height: 1.5; }
            table { 
              width: 100%; 
              border-collapse: collapse; 
              border: none; /* Remove table borders */
            }
            th, td { 
              padding: 8px; 
              text-align: left; 
              border: none; /* Remove cell borders */
            }
            .text-md { font-size: 16px; }
            .text-end { text-align: right; }
            .mt-3 { margin-top: 1rem; }
            .mb-3 { margin-bottom: 1rem; }
          </style>
        </head>
        <body>
          <table>
            <tr>
              <td colspan="2" style="text-align: center;">
                <img src="http://13.203.76.193/storage/uploads/logo/Black-Logo (1).png" alt="Logo Dark" style="max-width: 10px; max-height: 10px;">
             </td>
            </tr>
            <tr>
              <td style="text-align: left;">
                <h3>#CON0000001</h3>
              </td>
              
            </tr>
            <tr>
              <td colspan="2">
                <table>
                  <tr>
                    <td style="width: 50%;">
                      <p><strong>Contract Type:</strong> Employement</p>
                      <p><strong>Contract Value:</strong> ₹1,012.00</p>
                    </td>
                    <td style="width: 50%; text-align: right;">
                      <p><strong>Start Date:</strong> Feb 21, 2025</p>
                      <p><strong>End Date:</strong> Mar 8, 2025</p>
                    </td>
                  </tr>
                </table>
              </td>
            </tr>
            <tr>
              <td colspan="2">
                <p>Sit ad qui molestia</p>
                <br />
                <div></div>
              </td>
            </tr>
            <tr>
              <td style="width: 50%;">
                
                <div>
                  <h5>Company Signature</h5>
                </div>
              </td>
              <td style="width: 50%; text-align: right;">
                
                <div>
                  <h5>Employee Signature</h5>
                </div>
              </td>
          </table>
        </body>
      </html>
    